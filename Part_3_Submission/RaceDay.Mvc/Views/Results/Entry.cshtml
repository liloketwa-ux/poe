@model ResultsEntryPageViewModel
@functions {
    string Ordinal(int? value)
    {
        if (value is null) return "—";
        var n = value.Value; var rem100 = n % 100;
        var suffix = rem100 is >= 11 and <= 13 ? "th" : (n % 10) switch { 1 => "st", 2 => "nd", 3 => "rd", _ => "th" };
        return $"{n}{suffix}";
    }
}

@{ViewData["Title"]="Enter results";}
<div class="section-heading"><div><div class="eyebrow">RACE DAY OPERATIONS</div><h1>Results · @Model.EventName</h1></div></div>
<div class="panel mb-4"><h2 class="h4">Record a finish</h2><form asp-action="Capture" method="post"><input asp-for="Form.EventId" type="hidden"/><div class="row g-3"><div class="col-md-5"><label asp-for="Form.EnrolmentId" class="form-label">Participant entry</label><select asp-for="Form.EnrolmentId" class="form-select"><option value="">Choose participant</option>@foreach(var e in Model.Enrolments.Where(x=>x.Status=="Confirmed")){<option value="@e.EnrolmentId">@e.ParticipantName · @e.CategoryName</option>}</select></div><div class="col-md-3"><label asp-for="Form.FinishTime" class="form-label">Finish time</label><input asp-for="Form.FinishTime" type="time" step="1" class="form-control"/></div><div class="col-md-2"><label asp-for="Form.OverallPosition" class="form-label">Overall</label><input asp-for="Form.OverallPosition" type="number" min="1" class="form-control"/></div><div class="col-md-2"><label asp-for="Form.CategoryPosition" class="form-label">Category</label><input asp-for="Form.CategoryPosition" type="number" min="1" class="form-control"/></div><div class="col-md-3"><label asp-for="Form.AveragePace" class="form-label">Average pace</label><input asp-for="Form.AveragePace" type="number" step=".01" class="form-control"/></div><div class="col-md-3"><label asp-for="Form.FinishStatus" class="form-label">Finish status</label><select asp-for="Form.FinishStatus" class="form-select"><option>Finished</option><option>DNF</option><option>DNS</option></select></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-accent w-100">Publish result</button></div></div></form></div>
<div class="panel table-responsive"><h2 class="h4">Published results</h2><table class="table"><thead><tr><th>Participant</th><th>Category</th><th>Finish time</th><th>Overall finish position</th><th>Status</th></tr></thead><tbody>@foreach(var r in Model.Results){<tr><td>@r.ParticipantName</td><td>@r.CategoryName</td><td>@r.FinishTime</td><td>@Ordinal(r.OverallPosition) out of @r.TotalFinishers finishers</td><td>@r.FinishStatus</td></tr>}</tbody></table></div>