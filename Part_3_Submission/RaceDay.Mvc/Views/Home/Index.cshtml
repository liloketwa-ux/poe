@model IReadOnlyList<EventSummaryDto>
@{ViewData["Title"]="Discover Events";}
<section class="hero mb-5"><div class="hero-copy"><div class="eyebrow">SOUTH AFRICA · COMMUNITY SPORT</div><h1>Find your next<br/><span class="accent">finish line.</span></h1><p>Discover local running, walking and cycling events. Choose your distance, claim your place and make race day count.</p><a class="btn btn-accent btn-lg" href="#events">Explore events →</a></div><div class="hero-stats"><div><strong>01</strong><span>Find an event</span></div><div><strong>02</strong><span>Choose a category</span></div><div><strong>03</strong><span>Make it race day</span></div></div></section>
<section id="events"><div class="section-heading"><div><div class="eyebrow">THE STARTING LINE</div><h2>Upcoming events</h2></div><span class="muted">@Model.Count event(s)</span></div>
<form method="get" class="filter-bar mb-4"><select name="eventType" class="form-select"><option value="">All event types</option><option value="Running">Running</option><option value="Walking">Walking</option><option value="Cycling">Cycling</option></select><input name="province" value="@ViewBag.Province" class="form-control" placeholder="Filter by province"/><button class="btn btn-dark">Filter</button><a class="btn btn-outline-secondary" asp-action="Index">Reset</a></form>
@if(ViewBag.Error is string error){<div class="alert alert-warning">@error</div>}
<div class="row g-4">@foreach(var item in Model){<div class="col-md-6 col-xl-4"><article class="event-card h-100">
@if(!string.IsNullOrWhiteSpace(item.BannerImageUrl)){<img src="@item.BannerImageUrl" class="event-image" alt="@item.Name banner"/>}else{<div class="event-image event-placeholder"><span>@item.EventType.ToUpperInvariant()</span><b>@item.DistanceKm km</b></div>}
<div class="p-4"><div class="d-flex justify-content-between mb-2"><span class="tag">@item.EventType</span><span class="muted small">@item.EventDate.ToString("dd MMM yyyy")</span></div><h3>@item.Name</h3><p class="muted">@item.City, @item.Province · @item.Venue</p><div class="d-flex justify-content-between align-items-center"><span class="distance">@item.DistanceKm km</span><a class="text-link" asp-controller="Events" asp-action="Details" asp-route-id="@item.EventId">Event details →</a></div></div></article></div>}</div>
@if(Model.Count==0){<div class="empty-state">No events match those filters yet. Try resetting your search.</div>}</section>