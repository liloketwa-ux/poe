@model DashboardViewModel
@functions {
    string Ordinal(int? value)
    {
        if (value is null) return "—";
        var n = value.Value;
        var lastTwo = n % 100;
        if (lastTwo >= 11 && lastTwo <= 13) return $"{n}th";
        var last = n % 10;
        if (last == 1) return $"{n}st";
        if (last == 2) return $"{n}nd";
        if (last == 3) return $"{n}rd";
        return $"{n}th";
    }
}

@{ViewData["Title"]="Dashboard";}
<div class="section-heading"><div><div class="eyebrow">YOUR RACEDAY</div><h1>@(Model.Role=="Organiser"?"Organiser dashboard":"Participant dashboard")</h1><p class="muted">Welcome, @Context.Session.GetString("DisplayName").</p></div>@if(Model.Role=="Organiser"){<a class="btn btn-accent" asp-controller="Events" asp-action="Create">+ Create event</a>}</div>
@if(ViewBag.Error is string error){<div class="alert alert-warning">@error</div>}
@if(Model.Role=="Organiser"){
<div class="row g-3 mb-4"><div class="col-md-4"><div class="metric-card"><span>Events created</span><strong>@Model.Events.Count</strong></div></div><div class="col-md-4"><div class="metric-card"><span>Confirmed entries</span><strong>@Model.EnrolmentCounts.Values.Sum()</strong></div></div><div class="col-md-4"><div class="metric-card"><span>Upcoming events</span><strong>@Model.Events.Count(x=>x.EventDate>=DateOnly.FromDateTime(DateTime.Today))</strong></div></div></div>
<h2 class="h4">Your events</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Event</th><th>Date</th><th>Entries</th><th>Status</th><th>Manage</th></tr></thead><tbody>@foreach(var ev in Model.Events){<tr><td><b>@ev.Name</b><div class="muted small">@ev.City · @ev.DistanceKm km</div></td><td>@ev.EventDate.ToString("dd MMM yyyy")</td><td>@Model.EnrolmentCounts.GetValueOrDefault(ev.EventId)</td><td><span class="status">@ev.Status</span></td><td class="d-flex gap-2"><a asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventId">Manage</a><a asp-controller="Events" asp-action="Enrolments" asp-route-id="@ev.EventId">Entries</a><a asp-controller="Results" asp-action="Entry" asp-route-eventId="@ev.EventId">Results</a></td></tr>}</tbody></table></div>
}else{
<div class="row g-3 mb-4"><div class="col-md-6"><div class="metric-card"><span>My entries</span><strong>@Model.Enrolments.Count</strong></div></div><div class="col-md-6"><div class="metric-card"><span>Recorded results</span><strong>@Model.Results.Count</strong></div></div></div>
<h2 class="h4">My events</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Event</th><th>Category</th><th>Enrolled</th><th>Status</th></tr></thead><tbody>@foreach(var e in Model.Enrolments){<tr><td>@e.EventName</td><td>@e.CategoryName</td><td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td><td><span class="status @(e.Status=="Confirmed"?"confirmed":"cancelled")">@e.Status</span></td></tr>}</tbody></table></div>
<h2 class="h4 mt-5">My results</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Time</th><th>Finish position</th></tr></thead><tbody>@foreach(var r in Model.Results){<tr><td>@r.EventName</td><td>@r.EventDate.ToString("dd MMM yyyy")</td><td>@r.CategoryName</td><td>@(r.FinishTime?.ToString("HH:mm:ss")??r.FinishStatus)</td><td>@Ordinal(r.OverallPosition) out of @r.TotalFinishers finishers</td></tr>}</tbody></table></div>
}