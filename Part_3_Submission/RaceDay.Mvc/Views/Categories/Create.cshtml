@model CategoryFormViewModel
@{var action=Model.CategoryId==0?"Create":"Edit";ViewData["Title"]=Model.CategoryId==0?"Add category":"Edit category";}
<div class="form-shell"><div class="eyebrow">EVENT SETUP</div><h1>@ViewData["Title"]</h1><form asp-action="@action" method="post"><input asp-for="EventId" type="hidden"/><input asp-for="CategoryId" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="DistanceKm" class="form-label"></label><input asp-for="DistanceKm" type="number" step=".1" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="EntryFee" class="form-label"></label><input asp-for="EntryFee" type="number" step=".01" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="MaxEntries" class="form-label"></label><input asp-for="MaxEntries" class="form-control"/></div><div class="col-md-3 mb-3"><label asp-for="MinAge" class="form-label"></label><input asp-for="MinAge" class="form-control"/></div><div class="col-md-3 mb-3"><label asp-for="MaxAge" class="form-label"></label><input asp-for="MaxAge" class="form-control"/></div></div><button class="btn btn-accent">Save category</button> <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-outline-secondary">Cancel</a></form></div>