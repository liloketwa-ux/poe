@model EventFormViewModel
@{ViewData["Title"]=Model.EventId==0?"Create event":"Edit event";var action=Model.EventId==0?"Create":"Edit";}
<div class="form-shell"><div class="eyebrow">ORGANISER WORKSPACE</div><h1>@ViewData["Title"]</h1><p class="muted">Publish complete event information for participants.</p><form asp-action="@action" asp-route-id="@Model.EventId" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="3" class="form-control"></textarea></div><div class="row"><div class="col-md-4 mb-3"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="date" class="form-control"/></div><div class="col-md-4 mb-3"><label asp-for="RegistrationOpen" class="form-label">Registration opens</label><input asp-for="RegistrationOpen" type="date" class="form-control"/></div><div class="col-md-4 mb-3"><label asp-for="RegistrationClose" class="form-label">Registration closes</label><input asp-for="RegistrationClose" type="date" class="form-control"/></div></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="Venue" class="form-label"></label><input asp-for="Venue" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control"/></div></div><div class="row"><div class="col-md-4 mb-3"><label asp-for="Province" class="form-label"></label><input asp-for="Province" class="form-control"/></div><div class="col-md-4 mb-3"><label asp-for="DistanceKm" class="form-label"></label><input asp-for="DistanceKm" type="number" step=".1" class="form-control"/></div><div class="col-md-4 mb-3"><label asp-for="EventType" class="form-label"></label><select asp-for="EventType" class="form-select"><option>Running</option><option>Walking</option><option>Cycling</option></select></div></div><div class="mb-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Open</option><option>Draft</option><option>Closed</option><option>Completed</option><option>Cancelled</option></select></div><button class="btn btn-accent btn-lg">Save event</button> <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancel</a></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}