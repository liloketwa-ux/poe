@model EventDetailsDto
@{ViewData["Title"]=Model.Name;}
<div class="event-detail-hero">
@if(!string.IsNullOrWhiteSpace(Model.BannerImageUrl)){<img class="detail-banner" src="@Model.BannerImageUrl" alt="@Model.Name banner"/>}else{<div class="detail-banner event-placeholder"><span>@Model.EventType.ToUpperInvariant()</span><b>@Model.DistanceKm km</b></div>}
<div class="detail-overlay"><span class="tag">@Model.EventType</span><h1>@Model.Name</h1><p>@Model.City, @Model.Province · @Model.Venue</p><div class="distance">@Model.DistanceKm km</div></div></div>
<div class="row g-4 mt-2"><div class="col-lg-8"><div class="panel"><div class="eyebrow">ABOUT THIS EVENT</div><p>@Model.Description</p><div class="row g-3"><div class="col-md-4"><small class="muted">Event date</small><div class="fw-bold">@Model.EventDate.ToString("dd MMM yyyy")</div></div><div class="col-md-4"><small class="muted">Registration closes</small><div class="fw-bold">@Model.RegistrationClose.ToString("dd MMM yyyy")</div></div><div class="col-md-4"><small class="muted">Organiser</small><div class="fw-bold">@Model.OrganiserName</div></div></div></div>
<div class="panel mt-4"><div class="section-heading"><div><div class="eyebrow">PICK YOUR DISTANCE</div><h2>Available categories</h2></div></div>
@foreach(var c in Model.Categories){<div class="category-row"><div><h3>@c.Name</h3><p class="muted mb-0">@c.DistanceKm km · R @c.EntryFee · @c.EntriesTaken / @c.MaxEntries entries</p></div>@if(Context.Session.GetString("Role")=="Participant"){<form asp-action="Enrol" method="post"><input type="hidden" name="id" value="@Model.EventId"/><input type="hidden" name="categoryId" value="@c.CategoryId"/><button class="btn btn-accent btn-sm">Enter event</button></form>}
@if(Context.Session.GetString("Role")=="Organiser"){<div class="d-flex gap-2"><a class="btn btn-outline-dark btn-sm" asp-controller="Categories" asp-action="Edit" asp-route-eventId="@Model.EventId" asp-route-categoryId="@c.CategoryId">Edit category</a><form asp-controller="Categories" asp-action="Delete" asp-route-eventId="@Model.EventId" asp-route-categoryId="@c.CategoryId" method="post"><button class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete this category? Categories with enrolments cannot be deleted.')">Delete</button></form></div>}</div>}
@if(Model.Categories.Count==0){<p class="muted">No categories have been published for this event yet.</p>}</div>
@if(Model.Route is not null){<div class="panel mt-4"><h2>Course route</h2><p>@Model.Route.StartLocation → @Model.Route.FinishLocation</p><p class="muted">@Model.Route.Notes</p></div>}</div>
<div class="col-lg-4">@if(Context.Session.GetString("Role")=="Organiser"){
<div class="panel"><div class="eyebrow">ORGANISER TOOLS</div><div class="d-grid gap-2"><a class="btn btn-dark" asp-action="Edit" asp-route-id="@Model.EventId">Edit event</a><a class="btn btn-outline-dark" asp-controller="Categories" asp-action="Create" asp-route-eventId="@Model.EventId">Add category</a><a class="btn btn-outline-dark" asp-action="Enrolments" asp-route-id="@Model.EventId">View enrolments</a><a class="btn btn-outline-dark" asp-controller="Results" asp-action="Entry" asp-route-eventId="@Model.EventId">Enter results</a></div><hr/><form asp-action="UploadBanner" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data"><label class="form-label">Event banner image</label><input type="file" name="file" accept="image/png,image/jpeg,image/webp" class="form-control mb-2" required/><button class="btn btn-accent w-100">Upload banner via API</button></form><hr/><form asp-action="Delete" asp-route-id="@Model.EventId" method="post"><button class="btn btn-outline-danger w-100" onclick="return confirm('Delete this event?')">Delete event</button></form></div>
}else{<div class="panel"><div class="eyebrow">READY TO TAKE PART?</div><h2>Make it your race day.</h2><p class="muted">Log in or register as a Participant to choose a category and enter.</p>@if(Context.Session.GetString("Role") is null){<a class="btn btn-accent w-100" asp-controller="Account" asp-action="Register">Create participant account</a>}</div>}</div></div>